# The Fenji server as a systemd service, for the reference deployment in docs/hosting.md: the
# program in /usr/local/bin, its settings in /etc/fenji/fenji.toml, whose [store] path is
# /var/lib/fenji/fenji.db, and its data folder, /var/lib/fenji, for the fenji user alone.
# It goes in /etc/systemd/system.
[Unit]
Description=Fenji, a private server for Swords of Legends Online
Documentation=https://github.com/theintonerzero/fenji/blob/main/docs/hosting.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=fenji
Group=fenji
ExecStart=/usr/local/bin/fenji-server --config /etc/fenji/fenji.toml run
# The data folder holds the database, its backups, the server's key (tls/) and the console socket.
StateDirectory=fenji
StateDirectoryMode=0700
UMask=0077
# The server keeps a file open for each connection.
LimitNOFILE=4096
# A crash restarts the server. The console's stop, and systemctl stop, don't.
Restart=on-failure
RestartSec=5
# SIGTERM stops it as the console's stop does, saving everyone's place first. A stop takes 30
# seconds at most: 14 for the players' connections to close, 6 for the world's thread to end, 5
# for the last saves and 5 for attached consoles to take their goodbye. This gives it 5 more.
# Only closing the database can take longer, since it waits for what still uses it, such as a
# backup begun in the console: one still running at 35 seconds is cut short, and never passes
# for a backup.
TimeoutStopSec=35
# The sandbox: the system read-only and home folders hidden, and none of what the server never
# needs: privileges, devices, the clock, the kernel's settings, new namespaces or writable code.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
