# Single source of truth for pinned tool versions.
# Sourced by scripts/bootstrap.sh. CLAUDE.md mirrors this table; update both together
# in one commit (`chore(deps): ...`).

# Claude Code
CLAUDE_CODE_MIN="2.1.296"

# Rust (also pinned in rust-toolchain.toml)
RUST_TOOLCHAIN="1.97.1"
MINGW_FEDORA_PACKAGE="mingw64-gcc"   # linker for tools/oodle-helper (x86_64-pc-windows-gnu)
MINGW_BREW_PACKAGE="mingw-w64"

# Cargo-installed tools (cargo install --locked)
TAURI_CLI_VERSION="2.12.2"
GIT_CLIFF_VERSION="2.14.2"
CARGO_DENY_VERSION="0.20.2"
SQLX_CLI_VERSION="0.9.0"
BEVY_BRP_MCP_VERSION="0.23.0"   # must match bevy_brp_extras 0.23.x / Bevy 0.20

# JavaScript (launcher frontend)
NODE_MAJOR="24"                 # macOS: Homebrew node@24; Fedora: nodejs24
PNPM_VERSION="12.11.2"          # npm install -g --prefix ~/.local

# Reverse engineering
REA_AGENTS_VERSION="6.3.0"      # REA MCP server + bundled skill (skill metadata version 34)
JAVA_MAJOR="21"                 # Ghidra 12 runtime. macOS: Temurin 21 cask; Linux: Temurin tarball below
# Linux: Fedora 44 no longer packages JDK 21. Checksums from Adoptium's .sha256.txt release assets.
TEMURIN_VERSION="21.0.12.1+1"
TEMURIN_SHA256_linux_x64="ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94"
TEMURIN_SHA256_linux_arm64="23e37e026f12f3e706f18938ff611db3032d075b09d0879a25d06718c773e223"
GHIDRA_VERSION="12.1.4"         # REA native provider requires Ghidra 12.1.x; official release zip on both OSes
GHIDRA_RELEASE_DATE="20260921"
GHIDRA_SHA256="ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db"   # published in the release notes
# Lua decompiler: an external tool whose output stays in re/. MIT licence (docs/re/sources.md).
UNLUAC_VERSION="2025_12_23"
# Upstream publishes no checksum; computed from the official SourceForge asset on 2026-10-12.
UNLUAC_SHA256="98be0fa84ac73ca66dce2842a2e4512226f4c611b6500dc96415571fc5538fcc"

# Steam / Proton tooling
DEPOTDOWNLOADER_VERSION="3.4.0"
# Upstream publishes no checksums for 3.4.0; these were computed from the official release assets on 2026-10-11.
DEPOTDOWNLOADER_SHA256_macos_arm64="60e80c7c496f3f9a079cd3c62036b35d088c27bc0149baf38f009eb57a52f6a5"
DEPOTDOWNLOADER_SHA256_macos_x64="3214b689564d73e9342a8a4aef693de6ad3d293801b0f300a4466f60ec75befb"
DEPOTDOWNLOADER_SHA256_linux_x64="a999dec66b4850fc961bd50366696d23c2d0fad7b18790e6a5647b2f19097a53"
DEPOTDOWNLOADER_SHA256_linux_arm64="d9fb612ccebc1db8eeea3b4045d2221ec70431381393ce908fb72f01d4f9c812"
UMU_LAUNCHER_VERSION="1.4.4"    # Linux only, zipapp
UMU_LAUNCHER_SHA256="eb590691841f7fad3fc3ad8fd5db4ccb87849fe7948e62b28ece7a4ee48cc851"   # GitHub release digest
# GE-Proton: the Proton build every sandboxed client run uses (Linux x86_64 only).
GE_PROTON_VERSION="GE-Proton11-7"
GE_PROTON_SHA256_x86_64="c5448b76a230384e2d7bc6beb5ccb97bafb7e2c3b6c527cb03a1a546bbcb00a0"   # GitHub release digest

# Deployment (VPS only; not installed on dev machines)
CADDY_VERSION="2.11.7"

# ghidra-mcp (GUI plugin + Python MCP bridge); must match GHIDRA_VERSION exactly
GHIDRA_MCP_VERSION="7.0.0-rc.2"
GHIDRA_MCP_BRIDGE_VERSION="7.0.0"
GHIDRA_MCP_EXTENSION_SHA256="62db94e2687c734c34c2a85c32bc1b25e44d1e98baeba8980f17f28032614a8f"
GHIDRA_MCP_BRIDGE_SHA256="c4769b3d640698f022c65a88b7a30b2ba03e3a9af287120be4a065def5d404bf"
UV_MIN="0.12"
