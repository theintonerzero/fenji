{
  "title": "The final reading",
  "description": "Every disputed line, once, with its final English and why.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lines"],
  "properties": {
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fp", "en", "reason"],
        "properties": {
          "fp": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "description": "The line's fingerprint, copied exactly."
          },
          "en": {
            "type": "string",
            "description": "The line's final English."
          },
          "reason": {
            "type": "string",
            "description": "One short sentence on why."
          },
          "by_chance": {
            "type": "array",
            "items": { "type": "string" },
            "description": "The glossary's names, in Chinese, that the line holds only by chance and the final English leaves out; only on a line that has any."
          }
        }
      }
    }
  }
}
