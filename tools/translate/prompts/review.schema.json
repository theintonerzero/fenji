{
  "title": "A reviewer's answer",
  "description": "Every line of the batch, once: kept, or replaced with a reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lines"],
  "properties": {
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fp", "keep", "en", "reason"],
        "properties": {
          "fp": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "description": "The line's fingerprint, copied exactly."
          },
          "keep": {
            "type": "boolean",
            "description": "Whether the translation stands as it is."
          },
          "en": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "description": "Your English when keep is false; null when it's true."
          },
          "reason": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "description": "One short sentence on what was wrong when keep is false; null when it's true."
          }
        }
      }
    }
  }
}
